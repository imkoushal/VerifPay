# Base URL of the VerifPay FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Only needed if the backend has VERIFPAY_API_KEY set.
# NOTE: anything in a VITE_ variable ships in the client bundle and is
# publicly readable. Use a key scoped to the browser app, never an admin key.
VITE_API_KEY=

# Telegram bot link shown in the QR section
VITE_TELEGRAM_BOT_URL=https://t.me/VerifPayBot
