# VerifPay Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key - Used for both Llama 3 (fraud explanation) and Whisper (voice transcription)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PhishTank API Key
PHISHTANK_API_KEY=your_phishtank_api_key_here

# Google Safe Browsing API Key
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# PostgreSQL Connection String
DATABASE_URL=postgresql://verifpay:verifpay@localhost:5432/verifpay

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# VerifPay API Key — used for authenticating API requests (X-API-Key header)
# Leave empty to disable authentication (development mode)
VERIFPAY_API_KEY=
